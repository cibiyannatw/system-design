# Copy this file to .env.local and adjust values for your machine.
# .env.local is gitignored - it's personal to your local setup only.
#
# Cloud instances (Dev service / Prod service) do NOT read this file.
# Each cloud service sets these same variable names directly on its own
# dashboard (Render/Railway/Fly "Environment" tab).

ENVIRONMENT=local
DEBUG=True
APP_NAME=My Flask App (LOCAL)
APP_VERSION=0.0.0-local

DATABASE_HOST=localhost
DATABASE_NAME=local_database
API_BASE_URL=http://localhost:8000

TOTAL_USERS=2
ACTIVE_SESSIONS=1

FEATURE_ANALYTICS=False
FEATURE_EMAIL_NOTIFICATIONS=False
FEATURE_ADVANCED_SEARCH=False
FEATURE_DEBUG_MODE=True

# Secrets - fine to use dummy local values, real ones only live on
# each cloud service's dashboard, never committed anywhere.
SECRET_KEY=local-dev-secret
DATABASE_PASSWORD=local-dev-password
API_KEY=local-dev-api-key
